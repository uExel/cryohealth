  "cards": [
    {
      "dot": "cyan",
      "title": "Two write paths",
      "items": [
        "Observations: direct psycopg insert, deduped per lake/day/source",
        "Hazard scores: POST to CryoHealth-api with x-api-key, so tier and alert policy stay there"
      ]
    },
    {
      "dot": "amber",
      "title": "Failure isolation",
      "items": [
        "One lake's error is recorded and the batch moves on",
        "Hazard pass closes its DB connection before slow DEM, WorldPop and API calls"
      ]
    },
    {
      "dot": "emerald",
      "title": "Swappable scene source",
      "items": [
        "CdseSource when CDSE_CLIENT_ID is set, else Planetary Computer",
        "read_bands always returns pixel-aligned 10 m bands"
      ]
    }
  ]
