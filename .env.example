# PostgreSQL — same instance/database as CryoHealth-api (docker-compose `db` service)
DB_HOST=localhost
DB_PORT=5433
DB_USER=cryohealth
DB_PASSWORD=cryohealth-dev
DB_NAME=cryohealth

# Must match CryoHealth-api's JWT_SECRET exactly — tokens are verified by both services.
JWT_SECRET=change-me-in-prod
JWT_EXPIRES=12h

# CryoHealth-api base URL, used server-side only (no CORS on that service)
CRYOHEALTH_API_URL=http://localhost:3000

# CryoHealth-geo (hazard pipeline) base URL, used server-side only. Its /health, /run and
# /run-hazard endpoints have no CORS headers and no auth of their own, so the browser never
# calls them directly — the /api/admin/system-health* server routes proxy to it same-origin
# and gate on cryohealth_admin first.
CRYOHEALTH_GEO_URL=http://localhost:8000
